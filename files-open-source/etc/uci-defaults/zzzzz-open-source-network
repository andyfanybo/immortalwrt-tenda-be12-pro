#!/bin/sh
# Discover the hardware before applying defaults; never assume radio ordering.
. /lib/functions.sh
/sbin/wifi config

preset_dropbear() {
  local section="$1"
  uci -q delete "dropbear.$section.Interface"
  uci -q delete "dropbear.$section.DirectInterface"
  uci -q delete "dropbear.$section._direct"
  uci set "dropbear.$section.GatewayPorts=on"
}
config_load dropbear
config_foreach preset_dropbear dropbear
uci commit dropbear

seen_2g=0
seen_5g=0
preset_radio() {
  local section="$1" band ssid channel width iface
  config_get band "$section" band
  case "$band" in
    2g|2G)
      ssid='td2'; channel='auto'; width='EHT20'; seen_2g=1
      ;;
    5g|5G)
      ssid='test'; channel='36'; width='EHT160'; seen_5g=1
      ;;
    *) return 0 ;;
  esac
  uci set "wireless.$section.country=CN"
  uci set "wireless.$section.channel=$channel"
  uci set "wireless.$section.htmode=$width"
  uci set "wireless.$section.disabled=0"

  # Reuse the AP section generated by the mac80211 config generator.
  iface="default_$section"
  uci set "wireless.$iface=wifi-iface"
  uci set "wireless.$iface.device=$section"
  uci set "wireless.$iface.network=lan"
  uci set "wireless.$iface.mode=ap"
  uci set "wireless.$iface.ssid=$ssid"
  uci set "wireless.$iface.encryption=sae-mixed"
  uci set "wireless.$iface.ieee80211w=1"
  uci set "wireless.$iface.key=12345678a"
  uci set "wireless.$iface.disabled=0"
}
config_load wireless
config_foreach preset_radio wifi-device
# If discovery is not ready, retain this defaults script for the next boot.
[ "$seen_2g" = 1 ] && [ "$seen_5g" = 1 ] || exit 1
uci commit wireless
exit 0
